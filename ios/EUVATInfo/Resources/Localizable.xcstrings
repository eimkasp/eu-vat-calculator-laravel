        "compare.disclaimer": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VAT treatment depends on the transaction, customer status and goods or services supplied. Use this comparison as a rate reference and verify the applicable rule with the relevant authority."
                    }
                },
                "bg": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Третирането за целите на ДДС зависи от сделката, статуса на клиента и доставените стоки или услуги. Използвайте това сравнение като справка за ставките и проверете приложимото правило в компетентния орган."
                    }
                },
                "cs": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Uplatnění DPH závisí na transakci, postavení zákazníka a dodávaném zboží či službách. Toto srovnání používejte jako přehled sazeb a platné pravidlo si ověřte u příslušného úřadu."
                    }
                },
                "da": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Momsbehandlingen afhænger af transaktionen, kundens status og de leverede varer eller tjenesteydelser. Brug denne sammenligning som en satsoversigt, og kontrollér den gældende regel hos den relevante myndighed."
                    }
                },
                "de": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Die mehrwertsteuerliche Behandlung hängt von der Transaktion, vom Status des Kunden und von den gelieferten Waren oder erbrachten Dienstleistungen ab. Nutzen Sie diesen Vergleich als Übersicht der Sätze und prüfen Sie die anwendbare Regelung bei der zuständigen Behörde."
                    }
                },
                "el": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Η μεταχείριση για σκοπούς ΦΠΑ εξαρτάται από τη συναλλαγή, το καθεστώς του πελάτη και τα αγαθά ή τις υπηρεσίες που παρέχονται. Χρησιμοποιήστε αυτή τη σύγκριση ως αναφορά για τους συντελεστές και επαληθεύστε τον εφαρμοστέο κανόνα με την αρμόδια αρχή."
                    }
                },
                "es": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "El tratamiento del IVA depende de la operación, de la condición del cliente y de los bienes o servicios suministrados. Utilice esta comparación como referencia de tipos y verifique la norma aplicable con la autoridad competente."
                    }
                },
                "et": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Käibemaksukäsitlus sõltub tehingust, kliendi staatusest ning tarnitavatest kaupadest või teenustest. Kasutage seda võrdlust määrade ülevaatena ja kontrollige kohaldatavat reeglit asjaomaselt asutuselt."
                    }
                },
                "fi": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "ALV-kohtelu riippuu liiketoimesta, asiakkaan asemasta sekä myytävistä tavaroista tai palveluista. Käytä tätä vertailua verokantojen viitetietona ja tarkista sovellettava sääntö asianomaiselta viranomaiselta."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Le traitement TVA dépend de l'opération, du statut du client et des biens ou services fournis. Utilisez cette comparaison comme référence pour les taux et vérifiez la règle applicable auprès de l'autorité compétente."
                    }
                },
                "ga": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Braitheann an chóireáil CBL ar an idirbheart, ar stádas an chustaiméara agus ar na hearraí nó na seirbhísí a sholáthraítear. Úsáid an chomparáid seo mar thagairt do rátaí agus deimhnigh an riail is infheidhme leis an údarás ábhartha."
                    }
                },
                "hr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Porezni tretman PDV-a ovisi o transakciji, statusu kupca te isporučenim dobrima ili uslugama. Ovu usporedbu koristite kao referencu za stope, a primjenjivo pravilo provjerite kod nadležnog tijela."
                    }
                },
                "hu": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Az ÁFA-kezelés az ügylettől, az ügyfél státuszától és az értékesített termékektől vagy szolgáltatásoktól függ. Ezt az összehasonlítást kulcsreferenciaként használja, és az alkalmazandó szabályt ellenőrizze az illetékes hatóságnál."
                    }
                },
                "it": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Il trattamento IVA dipende dall'operazione, dallo status del cliente e dai beni o servizi forniti. Questo confronto va utilizzato come riferimento per le aliquote; la norma applicabile va verificata presso l'autorità competente."
                    }
                },
                "lt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "PVM apmokestinimas priklauso nuo sandorio, kliento statuso ir tiekiamų prekių ar teikiamų paslaugų. Šį palyginimą naudokite kaip tarifų orientyrą, o taikytiną taisyklę pasitikrinkite atitinkamoje institucijoje."
                    }
                },
                "lv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "PVN piemērošana ir atkarīga no darījuma, klienta statusa un piegādātajām precēm vai pakalpojumiem. Izmantojiet šo salīdzinājumu kā likmju atsauci un pārbaudiet piemērojamo noteikumu attiecīgajā iestādē."
                    }
                },
                "mt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "It-trattament tal-VAT jiddependi mit-tranżazzjoni, mill-istatus tal-klijent u mill-oġġetti jew mis-servizzi fornuti. Uża dan it-tqabbil bħala referenza għar-rati u vverifika r-regola applikabbli mal-awtorità rilevanti."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "De BTW-behandeling hangt af van de transactie, de status van de klant en de geleverde goederen of diensten. Gebruik deze vergelijking als tariefoverzicht en controleer de toepasselijke regel bij de bevoegde instantie."
                    }
                },
                "pl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Sposób rozliczenia VAT zależy od rodzaju transakcji, statusu klienta oraz dostarczanych towarów lub usług. Porównanie służy jako punkt odniesienia dla stawek – obowiązujące zasady należy zweryfikować we właściwym organie."
                    }
                },
                "pt-PT": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "O tratamento em sede de IVA depende da operação, do estatuto do cliente e dos bens ou serviços fornecidos. Utilize esta comparação como referência de taxas e confirme a regra aplicável junto da autoridade competente."
                    }
                },
                "ro": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tratamentul TVA depinde de tranzacție, de statutul clientului și de bunurile sau serviciile furnizate. Folosiți această comparație ca referință pentru cote și verificați regula aplicabilă la autoritatea competentă."
                    }
                },
                "sk": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Uplatňovanie DPH závisí od transakcie, postavenia zákazníka a dodávaného tovaru či služieb. Toto porovnanie používajte ako prehľad sadzieb a platné pravidlo si overte na príslušnom úrade."
                    }
                },
                "sl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Obravnava DDV je odvisna od transakcije, statusa stranke ter dobavljenega blaga ali opravljenih storitev. To primerjavo uporabite kot pregled stopenj, veljavno pravilo pa preverite pri pristojnem organu."
                    }
                },
                "sv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Momsbehandlingen beror på transaktionen, kundens status och de varor eller tjänster som tillhandahålls. Använd jämförelsen som referens för satserna och kontrollera tillämplig regel hos behörig myndighet."
                    }
                }
            }
        },
