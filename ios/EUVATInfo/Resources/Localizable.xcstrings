        "vies_page.rate_limited": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Too many lookups in a short time. Please wait a minute and try again."
                    }
                },
                "bg": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Твърде много проверки за кратко време. Моля, изчакайте минута и опитайте отново."
                    }
                },
                "cs": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Příliš mnoho ověření v krátkém čase. Počkejte prosím minutu a zkuste to znovu."
                    }
                },
                "da": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "For mange opslag på kort tid. Vent et minut, og prøv igen."
                    }
                },
                "de": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Zu viele Abfragen in kurzer Zeit. Bitte warten Sie eine Minute und versuchen Sie es dann erneut."
                    }
                },
                "el": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Πάρα πολλές αναζητήσεις σε σύντομο χρονικό διάστημα. Περιμένετε ένα λεπτό και δοκιμάστε ξανά."
                    }
                },
                "es": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Demasiadas consultas en poco tiempo. Espere un minuto y vuelva a intentarlo."
                    }
                },
                "et": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Liiga palju päringuid lühikese aja jooksul. Palun oodake minut ja proovige uuesti."
                    }
                },
                "fi": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Liian monta hakua lyhyessä ajassa. Odota minuutti ja yritä uudelleen."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Trop de vérifications en peu de temps. Veuillez patienter une minute, puis réessayer."
                    }
                },
                "ga": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "An iomarca cuardach i mbeagán ama. Fan nóiméad agus bain triail eile as."
                    }
                },
                "hr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Previše provjera u kratkom vremenu. Pričekajte minutu i pokušajte ponovno."
                    }
                },
                "hu": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Túl sok lekérdezés rövid idő alatt. Kérjük, várjon egy percet, és próbálja újra."
                    }
                },
                "it": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Troppe verifiche in poco tempo. Attendere un minuto e riprovare."
                    }
                },
                "lt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Per trumpą laiką atlikta per daug patikrinimų. Palaukite minutę ir bandykite dar kartą."
                    }
                },
                "lv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Pārāk daudz pārbaužu īsā laikā. Lūdzu, uzgaidiet minūti un mēģiniet vēlreiz."
                    }
                },
                "mt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Saru wisq tfittxijiet fi żmien qasir. Jekk jogħġbok stenna minuta u erġa' pprova."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Te veel controles in korte tijd. Wacht een minuut en probeer het opnieuw."
                    }
                },
                "pl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Zbyt wiele sprawdzeń w krótkim czasie. Odczekaj minutę i spróbuj ponownie."
                    }
                },
                "pt-PT": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Demasiadas consultas num curto espaço de tempo. Aguarde um minuto e tente novamente."
                    }
                },
                "ro": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Prea multe verificări într-un timp scurt. Vă rugăm să așteptați un minut și să încercați din nou."
                    }
                },
                "sk": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Príliš veľa overení v krátkom čase. Počkajte, prosím, minútu a skúste to znova."
                    }
                },
                "sl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Preveč preverjanj v kratkem času. Počakajte minuto in poskusite znova."
                    }
                },
                "sv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "För många sökningar på kort tid. Vänta en minut och försök igen."
                    }
                }
            }
        },
