        "history.no_changes": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "No VAT rate changes found matching your criteria"
                    }
                },
                "bg": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Не са намерени промени в ставките на ДДС, отговарящи на вашите критерии"
                    }
                },
                "cs": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Nebyly nalezeny žádné změny sazeb DPH odpovídající vašim kritériím"
                    }
                },
                "da": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ingen momssatsændringer fundet, der matcher dine kriterier"
                    }
                },
                "de": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Keine MwSt.-Satzänderungen gefunden, die Ihren Kriterien entsprechen"
                    }
                },
                "el": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Δεν βρέθηκαν αλλαγές συντελεστών ΦΠΑ που να ταιριάζουν με τα κριτήριά σας"
                    }
                },
                "es": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "No se encontraron cambios en los tipos de IVA que coincidan con tus criterios"
                    }
                },
                "et": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Teie kriteeriumidele vastavaid käibemaksumäärade muutusi ei leitud"
                    }
                },
                "fi": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Hakuehtojasi vastaavia ALV-kantojen muutoksia ei löytynyt"
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Aucun changement de taux de TVA ne correspond à vos critères"
                    }
                },
                "ga": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Níor aimsíodh aon athruithe rátaí CBL a mheaitseálann do chritéir"
                    }
                },
                "hr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Nisu pronađene promjene stopa PDV-a koje odgovaraju vašim kriterijima"
                    }
                },
                "hu": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Nem található a feltételeknek megfelelő áfakulcs-változás"
                    }
                },
                "it": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Nessuna variazione delle aliquote IVA trovata corrispondente ai tuoi criteri"
                    }
                },
                "lt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "PVM tarifų pokyčių, atitinkančių jūsų kriterijus, nerasta"
                    }
                },
                "lv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Nav atrasta PVN likmju izmaiņas, kas atbilstu jūsu kritērijiem"
                    }
                },
                "mt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ma nstabu l-ebda bidliet fir-rati tal-VAT li jaqblu mal-kriterji tiegħek"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Geen BTW-tariefwijzigingen gevonden die aan uw criteria voldoen"
                    }
                },
                "pl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Nie znaleziono zmian stawek VAT pasujących do wybranych kryteriów"
                    }
                },
                "pt-PT": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Não foram encontradas alterações de taxas de IVA que correspondam aos seus critérios"
                    }
                },
                "ro": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Nu au fost găsite modificări ale cotelor de TVA care să corespundă criteriilor dvs."
                    }
                },
                "sk": {
                    "stringUnit": {
                        "state": "translated",
