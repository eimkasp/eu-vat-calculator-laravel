        "vies_page.service_unavailable": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "The VIES service is temporarily unavailable. Please try again shortly."
                    }
                },
                "bg": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Услугата VIES е временно недостъпна. Моля, опитайте отново след малко."
                    }
                },
                "cs": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Služba VIES je dočasně nedostupná. Zkuste to prosím za chvíli znovu."
                    }
                },
                "da": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES-tjenesten er midlertidigt utilgængelig. Prøv igen om lidt."
                    }
                },
                "de": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Der VIES-Dienst ist vorübergehend nicht verfügbar. Bitte versuchen Sie es in Kürze erneut."
                    }
                },
                "el": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Η υπηρεσία VIES δεν είναι προσωρινά διαθέσιμη. Δοκιμάστε ξανά σε λίγο."
                    }
                },
                "es": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "El servicio VIES no está disponible temporalmente. Inténtelo de nuevo en unos instantes."
                    }
                },
                "et": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES-teenus ei ole ajutiselt saadaval. Palun proovige varsti uuesti."
                    }
                },
                "fi": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES-palvelu ei ole tilapäisesti käytettävissä. Yritä hetken kuluttua uudelleen."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Le service VIES est temporairement indisponible. Veuillez réessayer dans quelques instants."
                    }
                },
                "ga": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Níl seirbhís VIES ar fáil go sealadach. Bain triail eile as ar ball."
                    }
                },
                "hr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Usluga VIES privremeno nije dostupna. Pokušajte ponovno za nekoliko trenutaka."
                    }
                },
                "hu": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "A VIES szolgáltatás átmenetileg nem érhető el. Kérjük, próbálja újra rövidesen."
                    }
                },
                "it": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Il servizio VIES è temporaneamente non disponibile. Riprovare tra qualche istante."
                    }
                },
                "lt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES paslauga laikinai nepasiekiama. Netrukus bandykite dar kartą."
                    }
                },
                "lv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES pakalpojums īslaicīgi nav pieejams. Lūdzu, drīzumā mēģiniet vēlreiz."
                    }
                },
                "mt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Is-servizz VIES mhuwiex disponibbli temporanjament. Jekk jogħġbok erġa' pprova ftit tal-ħin oħra."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "De VIES-dienst is tijdelijk niet beschikbaar. Probeer het zo meteen opnieuw."
                    }
                },
                "pl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Usługa VIES jest chwilowo niedostępna. Spróbuj ponownie za chwilę."
                    }
                },
                "pt-PT": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "O serviço VIES está temporariamente indisponível. Tente novamente dentro de momentos."
                    }
                },
                "ro": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Serviciul VIES este temporar indisponibil. Vă rugăm să încercați din nou în scurt timp."
                    }
                },
                "sk": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Služba VIES je dočasne nedostupná. Skúste to, prosím, o chvíľu znova."
                    }
                },
                "sl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Storitev VIES začasno ni na voljo. Poskusite znova čez nekaj trenutkov."
                    }
                },
                "sv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES-tjänsten är tillfälligt otillgänglig. Försök igen om en stund."
                    }
                }
            }
        },
