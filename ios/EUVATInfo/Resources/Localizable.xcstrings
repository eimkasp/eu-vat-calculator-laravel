        "vies_page.format_legend": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 is a digit, L a letter and X a letter or a digit. Other characters appear as written."
                    }
                },
                "bg": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 е цифра, L е буква, а X е буква или цифра. Останалите знаци се изписват както са."
                    }
                },
                "cs": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 je číslice, L písmeno a X písmeno nebo číslice. Ostatní znaky se píší tak, jak jsou uvedeny."
                    }
                },
                "da": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 er et ciffer, L et bogstav og X et bogstav eller et ciffer. Andre tegn skrives som vist."
                    }
                },
                "de": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 steht für eine Ziffer, L für einen Buchstaben und X für einen Buchstaben oder eine Ziffer. Andere Zeichen stehen wie geschrieben."
                    }
                },
                "el": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 είναι ψηφίο, L γράμμα και X γράμμα ή ψηφίο. Οι υπόλοιποι χαρακτήρες γράφονται όπως εμφανίζονται."
                    }
                },
                "es": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 es un dígito, L una letra y X una letra o un dígito. Los demás caracteres se escriben tal cual."
                    }
                },
                "et": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 on number, L täht ja X täht või number. Muud märgid kirjutatakse nii, nagu need on."
                    }
                },
                "fi": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 on numero, L kirjain ja X kirjain tai numero. Muut merkit kirjoitetaan sellaisinaan."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 est un chiffre, L une lettre et X une lettre ou un chiffre. Les autres caractères s'écrivent tels quels."
                    }
                },
                "ga": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Is digit é 9, is litir é L agus is litir nó digit é X. Scríobhtar carachtair eile mar atá."
                    }
                },
                "hr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 je znamenka, L slovo, a X slovo ili znamenka. Ostali znakovi pišu se kako su navedeni."
                    }
                },
                "hu": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 számjegy, L betű, X betű vagy számjegy. A többi karakter úgy szerepel, ahogy írva van."
                    }
                },
                "it": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 è una cifra, L una lettera e X una lettera o una cifra. Gli altri caratteri si scrivono così come sono."
                    }
                },
                "lt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 yra skaitmuo, L raidė, o X raidė arba skaitmuo. Kiti ženklai rašomi taip, kaip nurodyta."
                    }
                },
                "lv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 ir cipars, L burts un X burts vai cipars. Pārējās rakstzīmes raksta tā, kā norādīts."
                    }
                },
                "mt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 huwa ċifra, L ittra u X ittra jew ċifra. Karattri oħra jinkitbu kif inhuma."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 is een cijfer, L een letter en X een letter of een cijfer. Andere tekens staan er zoals ze geschreven worden."
                    }
                },
                "pl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 to cyfra, L to litera, a X to litera lub cyfra. Pozostałe znaki zapisuje się tak, jak podano."
                    }
                },
                "pt-PT": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 é um algarismo, L uma letra e X uma letra ou um algarismo. Os outros caracteres escrevem-se tal como aparecem."
                    }
                },
                "ro": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 este o cifră, L o literă, iar X o literă sau o cifră. Celelalte caractere se scriu așa cum apar."
                    }
                },
                "sk": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 je číslica, L písmeno a X písmeno alebo číslica. Ostatné znaky sa píšu tak, ako sú uvedené."
                    }
                },
                "sl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 je števka, L črka, X pa črka ali števka. Drugi znaki se pišejo, kot so zapisani."
                    }
                },
                "sv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "9 är en siffra, L en bokstav och X en bokstav eller en siffra. Övriga tecken skrivs som de står."
                    }
                }
            }
        },
        "vies_page.format_mismatch": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "This does not look like a VAT number from %1$@ (%2$@). Check for a typing mistake, or validate it anyway."
                    }
                },
                "bg": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Това не прилича на ДДС номер от %1$@ (%2$@). Проверете за грешка при въвеждането или го проверете въпреки това."
                    }
                },
                "cs": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Toto nevypadá jako DIČ ze země %1$@ (%2$@). Zkontrolujte překlep, nebo číslo přesto ověřte."
                    }
                },
                "da": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Det ligner ikke et momsnummer fra %1$@ (%2$@). Tjek for en tastefejl, eller tjek nummeret alligevel."
                    }
                },
                "de": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Das sieht nicht nach einer USt-IdNr. aus %1$@ aus (%2$@). Prüfen Sie auf Tippfehler, oder lassen Sie die Nummer trotzdem prüfen."
                    }
                },
                "el": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Αυτό δεν μοιάζει με ΑΦΜ ΦΠΑ από %1$@ (%2$@). Ελέγξτε για τυπογραφικό λάθος ή ελέγξτε τον αριθμό ούτως ή άλλως."
                    }
                },
                "es": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "No parece un número de IVA de %1$@ (%2$@). Compruebe si hay un error de escritura o valídelo de todos modos."
                    }
                },
                "et": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "See ei näe välja nagu riigi %1$@ KMKR-number (%2$@). Kontrollige trükiviga või kontrollige numbrit ikkagi."
                    }
                },
                "fi": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tämä ei näytä maan %1$@ ALV-numerolta (%2$@). Tarkista kirjoitusvirhe tai tarkista numero silti."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Cela ne ressemble pas à un numéro de TVA du pays %1$@ (%2$@). Vérifiez s'il y a une faute de frappe, ou lancez quand même la vérification."
                    }
                },
                "ga": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ní cosúil gur uimhir CBL ó %1$@ í seo (%2$@). Seiceáil an bhfuil botún clóscríofa ann, nó seiceáil í ar aon nós."
                    }
                },
                "hr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ovo ne izgleda kao PDV broj iz zemlje %1$@ (%2$@). Provjerite tipfeler ili ipak provjerite broj."
                    }
                },
                "hu": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ez nem úgy néz ki, mint egy %1$@ közösségi adószám (%2$@). Ellenőrizze, nincs-e elírás, vagy ellenőriztesse így is."
                    }
                },
                "it": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Non sembra una partita IVA di %1$@ (%2$@). Controlla se c'è un errore di battitura o verificala comunque."
                    }
                },
                "lt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tai nepanašu į šalies %1$@ PVM mokėtojo kodą (%2$@). Patikrinkite, ar nėra rašybos klaidos, arba vis tiek patikrinkite kodą."
                    }
                },
                "lv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tas neizskatās pēc valsts %1$@ PVN numura (%2$@). Pārbaudiet, vai nav drukas kļūdas, vai tomēr pārbaudiet numuru."
                    }
                },
                "mt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Dan ma jidhirx numru tal-VAT minn %1$@ (%2$@). Iċċekkja għal żball fl-ittajpjar, jew ivvalidah xorta waħda."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Dit lijkt geen btw-nummer uit %1$@ (%2$@). Controleer op een typefout, of laat het nummer toch controleren."
                    }
                },
                "pl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "To nie wygląda na numer VAT z kraju %1$@ (%2$@). Sprawdź, czy nie ma literówki, albo zweryfikuj go mimo to."
                    }
                },
                "pt-PT": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Isto não parece um número de IVA de %1$@ (%2$@). Verifique se há um erro de escrita ou valide-o mesmo assim."
                    }
                },
                "ro": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Acesta nu pare un cod de TVA din %1$@ (%2$@). Verificați dacă există o greșeală de tastare sau verificați-l oricum."
                    }
                },
                "sk": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Toto nevyzerá ako IČ DPH z krajiny %1$@ (%2$@). Skontrolujte preklep, alebo číslo aj tak overte."
                    }
                },
                "sl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "To ni videti kot številka za DDV iz države %1$@ (%2$@). Preverite, ali je tipkarska napaka, ali številko vseeno preverite."
                    }
                },
                "sv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Det här ser inte ut som ett momsnummer från %1$@ (%2$@). Kontrollera om det finns ett skrivfel, eller kontrollera numret ändå."
                    }
                }
            }
        },
        "vies_page.format_note_gr": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Greece uses EL for VAT identification numbers, while GR remains its ISO country code."
                    }
                },
                "bg": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Гърция използва EL за идентификационните номера по ДДС, докато GR остава нейният ISO код на държавата."
                    }
                },
                "cs": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Řecko používá pro DIČ předponu EL, přičemž GR zůstává jeho kódem země podle ISO."
                    }
                },
                "da": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Grækenland bruger EL i momsregistreringsnumre, mens GR fortsat er landets ISO-landekode."
                    }
                },
                "de": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Griechenland verwendet für USt-IdNr. das Präfix EL, während GR der ISO-Ländercode bleibt."
                    }
                },
                "el": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Η Ελλάδα χρησιμοποιεί το πρόθεμα EL για τους αριθμούς φορολογικού μητρώου ΦΠΑ, ενώ ο κωδικός χώρας ISO της παραμένει GR."
                    }
                },
                "es": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Grecia utiliza EL para los números de identificación a efectos del IVA, mientras que GR sigue siendo su código de país ISO."
                    }
                },
                "et": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Kreeka kasutab käibemaksukohustuslase registreerimisnumbrites eesliidet EL, kuigi riigi ISO-kood on endiselt GR."
                    }
                },
                "fi": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Kreikka käyttää arvonlisäverotunnisteissa etuliitettä EL, vaikka sen ISO-maakoodi on edelleen GR."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "La Grèce utilise EL pour les numéros d'identification TVA, tandis que GR reste son code pays ISO."
                    }
                },
                "ga": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Úsáideann an Ghréig EL le haghaidh uimhreacha aitheantais CBL, ach is é GR a cód tíre ISO i gcónaí."
                    }
                },
                "hr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Grčka za PDV identifikacijske brojeve koristi oznaku EL, dok je GR i dalje njezina ISO oznaka države."
                    }
                },
                "hu": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Görögország az ÁFA-azonosító számokhoz az EL előtagot használja, ISO-országkódja pedig továbbra is GR."
                    }
                },
                "it": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "La Grecia utilizza EL per le partite IVA, mentre GR resta il suo codice paese ISO."
                    }
                },
                "lt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Graikija PVM mokėtojo identifikaciniams numeriams naudoja EL, o GR išlieka jos ISO šalies kodu."
                    }
                },
                "lv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Grieķija PVN identifikācijas numuros izmanto EL, bet tās ISO valsts kods joprojām ir GR."
                    }
                },
                "mt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Il-Greċja tuża EL għan-numri ta' identifikazzjoni tal-VAT, filwaqt li GR jibqa' l-kodiċi ISO tal-pajjiż tagħha."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Griekenland gebruikt EL voor BTW-identificatienummers, terwijl GR de ISO-landcode blijft."
                    }
                },
                "pl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Grecja stosuje prefiks EL w numerach identyfikacyjnych VAT, natomiast GR pozostaje jej kodem kraju ISO."
                    }
                },
                "pt-PT": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "A Grécia utiliza EL nos números de identificação para efeitos de IVA, enquanto GR continua a ser o seu código de país ISO."
                    }
                },
                "ro": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Grecia folosește EL pentru codurile de identificare în scopuri de TVA, în timp ce GR rămâne codul său ISO de țară."
                    }
                },
                "sk": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Grécko používa pre IČ DPH predponu EL, pričom GR zostáva jeho kódom krajiny podľa ISO."
                    }
                },
                "sl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Grčija za identifikacijske številke za DDV uporablja EL, GR pa ostaja njena koda države po standardu ISO."
                    }
                },
                "sv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Grekland använder EL i momsregistreringsnummer, medan GR fortfarande är landets ISO-landskod."
                    }
                }
            }
        },
        "vies_page.format_rejected": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES rejected this number because its format does not match %1$@ VAT numbers."
                    }
                },
                "bg": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES отхвърли този номер, защото форматът му не съответства на ДДС номерата на %1$@."
                    }
                },
                "cs": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES toto číslo odmítl, protože jeho formát neodpovídá DIČ země %1$@."
                    }
                },
                "da": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES afviste nummeret, fordi formatet ikke svarer til momsnumre fra %1$@."
                    }
                },
                "de": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES hat diese Nummer abgelehnt, da ihr Format nicht dem der USt-IdNr. aus %1$@ entspricht."
                    }
                },
                "el": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Το VIES απέρριψε τον αριθμό, επειδή η μορφή του δεν αντιστοιχεί στους ΑΦΜ της χώρας %1$@."
                    }
                },
                "es": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES ha rechazado este número porque su formato no coincide con el de los números de IVA de %1$@."
                    }
                },
                "et": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES lükkas numbri tagasi, sest selle vorming ei vasta %1$@ käibemaksunumbrite vormingule."
                    }
                },
                "fi": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES hylkäsi numeron, koska sen muoto ei vastaa maan %1$@ ALV-numeroita."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES a rejeté ce numéro, car son format ne correspond pas à celui des numéros de TVA %1$@."
                    }
                },
                "ga": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Dhiúltaigh VIES don uimhir seo mar nach dtagann a formáid le huimhreacha CBL %1$@."
                    }
                },
                "hr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES je odbio ovaj broj jer njegov format ne odgovara PDV brojevima za državu %1$@."
                    }
                },
                "hu": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "A VIES elutasította ezt a számot, mert formátuma nem felel meg a következő ország ÁFA-számainak: %1$@."
                    }
                },
                "it": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES ha respinto questo numero perché il formato non corrisponde a quello delle partite IVA rilasciate in %1$@."
                    }
                },
                "lt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES atmetė šį numerį, nes jo formatas neatitinka šalies %1$@ PVM numerių formato."
                    }
                },
                "lv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES noraidīja šo numuru, jo tā formāts neatbilst %1$@ PVN numuru formātam."
                    }
                },
                "mt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Il-VIES irrifjutat dan in-numru għax il-format tiegħu ma jaqbilx man-numri tal-VAT ta' %1$@."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES heeft dit nummer afgewezen omdat het formaat niet overeenkomt met dat van BTW-nummers uit %1$@."
                    }
                },
                "pl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES odrzucił ten numer, ponieważ jego format nie odpowiada formatowi numerów VAT z kraju %1$@."
                    }
                },
                "pt-PT": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "O VIES rejeitou este número porque o formato não corresponde ao dos números de IVA de %1$@."
                    }
                },
                "ro": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES a respins acest număr deoarece formatul său nu corespunde numerelor de TVA din %1$@."
                    }
                },
                "sk": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES toto číslo zamietol, pretože jeho formát nezodpovedá IČ DPH krajiny %1$@."
                    }
                },
                "sl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES je to številko zavrnil, ker njena oblika ne ustreza številkam DDV države %1$@."
                    }
                },
                "sv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES avvisade numret eftersom formatet inte stämmer med momsnummer från %1$@."
                    }
                }
            }
        },
        "vies_page.invalid_format": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Enter the VAT number using letters and digits only, for example LT100019070512."
                    }
                },
                "bg": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Въведете ДДС номера само с букви и цифри, например LT100019070512."
                    }
                },
                "cs": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Zadejte DIČ pouze pomocí písmen a číslic, například LT100019070512."
                    }
                },
                "da": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Indtast momsnummeret med kun bogstaver og cifre, f.eks. LT100019070512."
                    }
                },
                "de": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Geben Sie die USt-IdNr. nur mit Buchstaben und Ziffern ein, zum Beispiel LT100019070512."
                    }
                },
                "el": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Εισαγάγετε τον ΑΦΜ χρησιμοποιώντας μόνο γράμματα και ψηφία, για παράδειγμα LT100019070512."
                    }
                },
                "es": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Introduzca el número de IVA solo con letras y dígitos, por ejemplo LT100019070512."
                    }
                },
                "et": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Sisestage käibemaksunumber ainult tähtede ja numbritega, näiteks LT100019070512."
                    }
                },
                "fi": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Syötä ALV-numero pelkillä kirjaimilla ja numeroilla, esimerkiksi LT100019070512."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Saisissez le numéro de TVA en lettres et en chiffres uniquement, par exemple LT100019070512."
                    }
                },
                "ga": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Cuir isteach an uimhir CBL le litreacha agus digití amháin, mar shampla LT100019070512."
                    }
                },
                "hr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Unesite PDV broj koristeći samo slova i znamenke, na primjer LT100019070512."
                    }
                },
                "hu": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Az ÁFA-számot csak betűkkel és számjegyekkel adja meg, például: LT100019070512."
                    }
                },
                "it": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Inserire la partita IVA utilizzando solo lettere e cifre, ad esempio LT100019070512."
                    }
                },
                "lt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Įveskite PVM numerį naudodami tik raides ir skaitmenis, pavyzdžiui, LT100019070512."
                    }
                },
                "lv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ievadiet PVN numuru, izmantojot tikai burtus un ciparus, piemēram, LT100019070512."
                    }
                },
                "mt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Daħħal in-numru tal-VAT b'ittri u ċifri biss, pereżempju LT100019070512."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Voer het BTW-nummer in met alleen letters en cijfers, bijvoorbeeld LT100019070512."
                    }
                },
                "pl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Wpisz numer VAT, używając wyłącznie liter i cyfr, np. LT100019070512."
                    }
                },
                "pt-PT": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Introduza o número de IVA apenas com letras e dígitos, por exemplo LT100019070512."
                    }
                },
                "ro": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Introduceți numărul de TVA folosind doar litere și cifre, de exemplu LT100019070512."
                    }
                },
                "sk": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Zadajte IČ DPH iba pomocou písmen a číslic, napríklad LT100019070512."
                    }
                },
                "sl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Vnesite številko DDV samo s črkami in števkami, na primer LT100019070512."
                    }
                },
                "sv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ange momsnumret med endast bokstäver och siffror, till exempel LT100019070512."
                    }
                }
            }
        },
