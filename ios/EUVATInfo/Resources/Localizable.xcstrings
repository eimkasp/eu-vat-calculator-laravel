        "vies_page.unsupported_country": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Choose an EU member state. VIES only covers EU VAT numbers."
                    }
                },
                "bg": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Изберете държава членка на ЕС. VIES обхваща само ДДС номера от ЕС."
                    }
                },
                "cs": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Vyberte členský stát EU. VIES zahrnuje pouze DIČ členských států EU."
                    }
                },
                "da": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Vælg en EU-medlemsstat. VIES dækker kun EU-momsnumre."
                    }
                },
                "de": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Wählen Sie einen EU-Mitgliedstaat aus. VIES umfasst nur USt-IdNr. aus der EU."
                    }
                },
                "el": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Επιλέξτε ένα κράτος μέλος της ΕΕ. Το VIES καλύπτει μόνο ΑΦΜ της ΕΕ."
                    }
                },
                "es": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Elija un Estado miembro de la UE. VIES solo cubre números de IVA de la UE."
                    }
                },
                "et": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Valige EL-i liikmesriik. VIES hõlmab ainult EL-i käibemaksunumbreid."
                    }
                },
                "fi": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Valitse EU-jäsenvaltio. VIES kattaa vain EU-maiden ALV-numerot."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Choisissez un État membre de l'UE. VIES ne couvre que les numéros de TVA de l'UE."
                    }
                },
                "ga": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Roghnaigh ballstát den AE. Ní chlúdaíonn VIES ach uimhreacha CBL an AE."
                    }
                },
                "hr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Odaberite državu članicu EU-a. VIES obuhvaća samo PDV brojeve iz EU-a."
                    }
                },
                "hu": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Válasszon EU-tagállamot. A VIES csak uniós ÁFA-számokra terjed ki."
                    }
                },
                "it": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Selezionare uno Stato membro dell'UE. VIES copre solo le partite IVA dell'UE."
                    }
                },
                "lt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Pasirinkite ES valstybę narę. VIES apima tik ES valstybių narių PVM numerius."
                    }
                },
                "lv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Izvēlieties ES dalībvalsti. VIES aptver tikai ES PVN numurus."
                    }
                },
                "mt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Agħżel stat membru tal-UE. Il-VIES tkopri biss numri tal-VAT tal-UE."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Kies een EU-lidstaat. VIES dekt alleen BTW-nummers uit de EU."
                    }
                },
                "pl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Wybierz państwo członkowskie UE. VIES obejmuje wyłącznie numery VAT z UE."
                    }
                },
                "pt-PT": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Escolha um Estado-Membro da UE. O VIES abrange apenas números de IVA da UE."
                    }
                },
                "ro": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Alegeți un stat membru al UE. VIES acoperă doar numerele de TVA din UE."
                    }
                },
                "sk": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Vyberte členský štát EÚ. VIES zahŕňa iba IČ DPH členských štátov EÚ."
                    }
                },
                "sl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Izberite državo članico EU. VIES zajema samo številke DDV držav članic EU."
                    }
                },
                "sv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Välj en EU-medlemsstat. VIES omfattar endast momsnummer från EU."
                    }
                }
            }
        },
