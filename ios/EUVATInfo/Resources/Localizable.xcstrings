        "vies_page.disclaimer": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Validation results come from the European Commission VIES database. Results are cached for speed, so confirm critical decisions with your national tax administration."
                    }
                },
                "bg": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Резултатите от валидирането идват от базата данни VIES на Европейската комисия. Резултатите се кешират за по-голяма скорост, затова потвърждавайте важните решения с националната данъчна администрация."
                    }
                },
                "cs": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Výsledky ověření pocházejí z databáze VIES Evropské komise. Kvůli rychlosti se výsledky ukládají do mezipaměti, proto zásadní rozhodnutí ověřte u své národní daňové správy."
                    }
                },
                "da": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Valideringsresultaterne kommer fra Europa-Kommissionens VIES-database. Resultaterne caches for at give hurtigere svar, så bekræft vigtige beslutninger hos din nationale skattemyndighed."
                    }
                },
                "de": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Die Prüfergebnisse stammen aus der VIES-Datenbank der Europäischen Kommission. Ergebnisse werden zur Beschleunigung zwischengespeichert. Bestätigen Sie wichtige Entscheidungen daher bei Ihrer nationalen Steuerverwaltung."
                    }
                },
                "el": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Τα αποτελέσματα επαλήθευσης προέρχονται από τη βάση δεδομένων VIES της Ευρωπαϊκής Επιτροπής. Τα αποτελέσματα αποθηκεύονται προσωρινά για μεγαλύτερη ταχύτητα, γι’ αυτό επιβεβαιώνετε τις κρίσιμες αποφάσεις με την εθνική φορολογική διοίκηση."
                    }
                },
                "es": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Los resultados de la validación proceden de la base de datos VIES de la Comisión Europea. Se almacenan en caché para mayor rapidez, por lo que conviene confirmar las decisiones importantes con su administración tributaria nacional."
                    }
                },
                "et": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Kontrolli tulemused pärinevad Euroopa Komisjoni VIES-i andmebaasist. Tulemused salvestatakse kiiruse huvides vahemällu, seega kinnitage olulised otsused oma riigi maksuhalduriga."
                    }
                },
                "fi": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tarkistustulokset ovat peräisin Euroopan komission VIES-tietokannasta. Tulokset tallennetaan välimuistiin nopeuden vuoksi, joten varmista tärkeät päätökset kansalliselta veroviranomaiselta."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les résultats de validation proviennent de la base de données VIES de la Commission européenne. Ils sont mis en cache pour plus de rapidité : confirmez donc les décisions importantes auprès de votre administration fiscale nationale."
                    }
                },
                "ga": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tagann torthaí bailíochtaithe ó bhunachar sonraí VIES an Choimisiúin Eorpaigh. Cuirtear torthaí i dtaisce ar mhaithe le luas, mar sin deimhnigh cinntí criticiúla le do riarachán cánach náisiúnta."
                    }
                },
                "hr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Rezultati provjere potječu iz baze podataka VIES Europske komisije. Radi brzine rezultati se privremeno pohranjuju, stoga ključne odluke potvrdite kod nacionalne porezne uprave."
                    }
                },
                "hu": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Az ellenőrzési eredmények az Európai Bizottság VIES-adatbázisából származnak. Az eredményeket a gyorsaság érdekében gyorsítótárazzuk, ezért a fontos döntéseket egyeztesse a nemzeti adóhatósággal."
                    }
                },
                "it": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "I risultati della validazione provengono dal database VIES della Commissione Europea. Vengono memorizzati nella cache per maggiore rapidità: per le decisioni importanti si consiglia di chiedere conferma all'amministrazione fiscale nazionale."
                    }
                },
                "lt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tikrinimo rezultatai gaunami iš Europos Komisijos VIES duomenų bazės. Kad veiktų greičiau, rezultatai saugomi talpykloje, todėl svarbius sprendimus pasitikrinkite savo šalies mokesčių administracijoje."
                    }
                },
                "lv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Pārbaudes rezultāti iegūti no Eiropas Komisijas VIES datubāzes. Ātruma nolūkos rezultāti tiek saglabāti kešatmiņā, tāpēc svarīgus lēmumus apstipriniet savas valsts nodokļu administrācijā."
                    }
                },
                "mt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ir-riżultati tal-validazzjoni ġejjin mill-bażi tad-data VIES tal-Kummissjoni Ewropea. Ir-riżultati jinħażnu temporanjament għal aktar ħeffa, għalhekk ikkonferma d-deċiżjonijiet kritiċi mal-amministrazzjoni nazzjonali tat-taxxa tiegħek."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Validatieresultaten zijn afkomstig uit de VIES-database van de Europese Commissie. Resultaten worden voor de snelheid tijdelijk opgeslagen; controleer belangrijke beslissingen daarom bij uw nationale belastingdienst."
                    }
                },
                "pl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Wyniki walidacji pochodzą z bazy danych VIES Komisji Europejskiej. Wyniki są buforowane dla szybkości, dlatego ważne decyzje należy potwierdzić w krajowej administracji podatkowej."
                    }
                },
                "pt-PT": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Os resultados da validação provêm da base de dados VIES da Comissão Europeia. Os resultados ficam em cache para maior rapidez, pelo que deve confirmar decisões críticas junto da sua administração fiscal nacional."
                    }
                },
                "ro": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Rezultatele validării provin din baza de date VIES a Comisiei Europene. Rezultatele sunt memorate în cache pentru viteză, așa că verificați deciziile importante la administrația fiscală națională."
                    }
                },
                "sk": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Výsledky overenia pochádzajú z databázy VIES Európskej komisie. Kvôli rýchlosti sa výsledky ukladajú do medzipamäte, preto zásadné rozhodnutia overte na svojej národnej daňovej správe."
                    }
                },
                "sl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Rezultati preverjanja prihajajo iz zbirke podatkov VIES Evropske komisije. Zaradi hitrosti se rezultati shranjujejo v predpomnilnik, zato pomembne odločitve potrdite pri svoji nacionalni davčni upravi."
                    }
                },
                "sv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Valideringsresultaten kommer från Europeiska kommissionens VIES-databas. Resultaten cachelagras för snabbhetens skull, så bekräfta viktiga beslut med din nationella skattemyndighet."
                    }
                }
            }
        },
