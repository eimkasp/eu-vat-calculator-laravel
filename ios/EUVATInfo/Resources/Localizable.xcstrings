        "vies_page.recent_privacy": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Stored on this device only, never sent to our servers."
                    }
                },
                "bg": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Съхраняват се само на това устройство и никога не се изпращат до нашите сървъри."
                    }
                },
                "cs": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Uloženo pouze v tomto zařízení, nikdy se neodesílá na naše servery."
                    }
                },
                "da": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Gemmes kun på denne enhed og sendes aldrig til vores servere."
                    }
                },
                "de": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Nur auf diesem Gerät gespeichert und nie an unsere Server gesendet."
                    }
                },
                "el": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Αποθηκεύονται μόνο σε αυτή τη συσκευή και δεν αποστέλλονται ποτέ στους διακομιστές μας."
                    }
                },
                "es": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Se guardan solo en este dispositivo y nunca se envían a nuestros servidores."
                    }
                },
                "et": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Salvestatakse ainult selles seadmes ega saadeta kunagi meie serveritesse."
                    }
                },
                "fi": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tallennetaan vain tälle laitteelle, eikä niitä koskaan lähetetä palvelimillemme."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Enregistrées uniquement sur cet appareil, jamais envoyées à nos serveurs."
                    }
                },
                "ga": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Stóráilte ar an ngléas seo amháin, ní sheoltar chuig ár bhfreastalaithe iad riamh."
                    }
                },
                "hr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Pohranjeno samo na ovom uređaju, nikada se ne šalje na naše poslužitelje."
                    }
                },
                "hu": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Csak ezen az eszközön tároljuk, és soha nem küldjük el a szervereinkre."
                    }
                },
                "it": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Salvate solo su questo dispositivo, mai inviate ai nostri server."
                    }
                },
                "lt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Saugoma tik šiame įrenginyje ir niekada nesiunčiama į mūsų serverius."
                    }
                },
                "lv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tiek glabātas tikai šajā ierīcē un nekad netiek sūtītas uz mūsu serveriem."
                    }
                },
                "mt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Maħżuna biss f'dan l-apparat, qatt ma jintbagħtu lis-servers tagħna."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Alleen op dit apparaat opgeslagen, nooit naar onze servers verzonden."
                    }
                },
                "pl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Zapisywane tylko na tym urządzeniu, nigdy nie są wysyłane na nasze serwery."
                    }
                },
                "pt-PT": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Guardadas apenas neste dispositivo e nunca enviadas para os nossos servidores."
                    }
                },
                "ro": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Stocate doar pe acest dispozitiv, nu sunt trimise niciodată către serverele noastre."
                    }
                },
                "sk": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Uložené iba v tomto zariadení, nikdy sa neodosiela na naše servery."
                    }
                },
                "sl": {
                    "stringUnit": {
