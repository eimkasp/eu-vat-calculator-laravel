        "calculator.unavailable_desc": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Supported country rates could not be loaded. Please try again shortly."
                    }
                },
                "bg": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ставките на поддържаните държави не можаха да бъдат заредени. Моля, опитайте отново след малко."
                    }
                },
                "cs": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Sazby podporovaných zemí se nepodařilo načíst. Zkuste to prosím za chvíli znovu."
                    }
                },
                "da": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Satserne for de understøttede lande kunne ikke indlæses. Prøv igen om lidt."
                    }
                },
                "de": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Die Sätze der unterstützten Länder konnten nicht geladen werden. Bitte versuchen Sie es in Kürze erneut."
                    }
                },
                "el": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Δεν ήταν δυνατή η φόρτωση των συντελεστών των υποστηριζόμενων χωρών. Δοκιμάστε ξανά σε λίγο."
                    }
                },
                "es": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "No se han podido cargar los tipos de los países disponibles. Inténtelo de nuevo en unos instantes."
                    }
                },
                "et": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Toetatud riikide määrasid ei õnnestunud laadida. Palun proovige varsti uuesti."
                    }
                },
                "fi": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tuettujen maiden verokantoja ei voitu ladata. Yritä hetken kuluttua uudelleen."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les taux des pays pris en charge n'ont pas pu être chargés. Veuillez réessayer dans quelques instants."
                    }
                },
                "ga": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Níorbh fhéidir rátaí na dtíortha a dtacaítear leo a lódáil. Bain triail eile as ar ball."
                    }
                },
                "hr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Stope podržanih država nije bilo moguće učitati. Pokušajte ponovno za nekoliko trenutaka."
                    }
                },
                "hu": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "A támogatott országok kulcsait nem sikerült betölteni. Kérjük, próbálja újra rövidesen."
                    }
                },
                "it": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Non è stato possibile caricare le aliquote dei paesi supportati. Riprovare tra qualche istante."
                    }
                },
                "lt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Nepavyko įkelti palaikomų šalių tarifų. Netrukus bandykite dar kartą."
                    }
                },
                "lv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Neizdevās ielādēt atbalstīto valstu likmes. Lūdzu, drīzumā mēģiniet vēlreiz."
                    }
                },
                "mt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ma kienx possibbli li jitgħabbew ir-rati tal-pajjiżi appoġġati. Jekk jogħġbok erġa' pprova ftit tal-ħin oħra."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "De tarieven van de ondersteunde landen konden niet worden geladen. Probeer het zo meteen opnieuw."
                    }
                },
                "pl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Nie udało się wczytać stawek obsługiwanych krajów. Spróbuj ponownie za chwilę."
                    }
                },
                "pt-PT": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Não foi possível carregar as taxas dos países suportados. Tente novamente dentro de momentos."
                    }
                },
                "ro": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Cotele țărilor acceptate nu au putut fi încărcate. Vă rugăm să încercați din nou în scurt timp."
                    }
                },
                "sk": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Sadzby podporovaných krajín sa nepodarilo načítať. Skúste to, prosím, o chvíľu znova."
                    }
                },
                "sl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Stopenj podprtih držav ni bilo mogoče naložiti. Poskusite znova čez nekaj trenutkov."
                    }
                },
                "sv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Det gick inte att läsa in satserna för de länder som stöds. Försök igen om en stund."
                    }
                }
            }
        },
