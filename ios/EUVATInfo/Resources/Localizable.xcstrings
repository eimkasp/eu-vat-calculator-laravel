        "compare.example_note": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Each figure is in the country's own currency."
                    }
                },
                "bg": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Всяка стойност е в собствената валута на държавата."
                    }
                },
                "cs": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Každá hodnota je uvedena v měně dané země."
                    }
                },
                "da": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Hvert tal er i landets egen valuta."
                    }
                },
                "de": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Alle Beträge in der jeweiligen Landeswährung."
                    }
                },
                "el": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Κάθε ποσό εκφράζεται στο νόμισμα της αντίστοιχης χώρας."
                    }
                },
                "es": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Cada cifra se expresa en la moneda del país."
                    }
                },
                "et": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Kõik summad on vastava riigi valuutas."
                    }
                },
                "fi": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Kaikki luvut ovat kyseisen maan omassa valuutassa."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Chaque montant est exprimé dans la devise du pays."
                    }
                },
                "ga": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tá gach figiúr in airgeadra na tíre féin."
                    }
                },
                "hr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Svaki je iznos izražen u valuti pojedine države."
                    }
                },
                "hu": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Minden összeg az adott ország saját pénznemében értendő."
                    }
                },
                "it": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ogni importo è espresso nella valuta del paese."
                    }
                },
                "lt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Kiekviena suma nurodyta tos šalies valiuta."
                    }
                },
                "lv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Katrs skaitlis norādīts attiecīgās valsts valūtā."
                    }
                },
                "mt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Kull ċifra hija fil-munita tal-pajjiż rispettiv."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Elk bedrag is in de eigen valuta van het land."
                    }
                },
                "pl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Każda kwota jest podana w walucie danego kraju."
                    }
                },
                "pt-PT": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Cada valor está na moeda do respetivo país."
                    }
                },
                "ro": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Fiecare valoare este exprimată în moneda țării respective."
                    }
                },
                "sk": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Každá hodnota je uvedená v mene danej krajiny."
                    }
                },
                "sl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Vsi zneski so v valuti posamezne države."
                    }
                },
                "sv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Varje belopp anges i landets egen valuta."
                    }
                }
            }
        },
