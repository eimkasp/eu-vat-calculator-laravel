        "vies_page.result_invalid_desc": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES could not confirm this number as active for intra-EU trade. Check the digits or ask your customer to confirm their registration."
                    }
                },
                "bg": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES не можа да потвърди, че този номер е активен за търговия в рамките на ЕС. Проверете цифрите или помолете клиента си да потвърди регистрацията си."
                    }
                },
                "cs": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES nemohl potvrdit, že je toto číslo aktivní pro obchod v rámci EU. Zkontrolujte číslice nebo požádejte zákazníka o potvrzení registrace."
                    }
                },
                "da": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES kunne ikke bekræfte, at dette nummer er aktivt til handel inden for EU. Kontrollér cifrene, eller bed din kunde om at bekræfte sin registrering."
                    }
                },
                "de": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES konnte nicht bestätigen, dass diese Nummer für den innergemeinschaftlichen Handel aktiv ist. Prüfen Sie die Ziffern oder bitten Sie Ihren Kunden, seine Registrierung zu bestätigen."
                    }
                },
                "el": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Το VIES δεν μπόρεσε να επιβεβαιώσει ότι ο αριθμός αυτός είναι ενεργός για ενδοκοινοτικές συναλλαγές. Ελέγξτε τα ψηφία ή ζητήστε από τον πελάτη σας να επιβεβαιώσει την εγγραφή του."
                    }
                },
                "es": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES no ha podido confirmar que este número esté activo para operaciones intracomunitarias. Compruebe los dígitos o pida a su cliente que confirme su registro."
                    }
                },
                "et": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES ei suutnud kinnitada, et see number on EL-i siseseks kaubanduseks aktiivne. Kontrollige numbreid või paluge kliendil oma registreeringut kinnitada."
                    }
                },
                "fi": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES ei voinut vahvistaa, että numero on voimassa yhteisökaupassa. Tarkista numerot tai pyydä asiakastasi vahvistamaan rekisteröintinsä."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES n'a pas pu confirmer que ce numéro est actif pour les échanges intracommunautaires. Vérifiez les chiffres ou demandez à votre client de confirmer son immatriculation."
                    }
                },
                "ga": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Níorbh fhéidir le VIES a dhearbhú go bhfuil an uimhir seo gníomhach le haghaidh trádála laistigh den AE. Seiceáil na digití nó iarr ar do chustaiméir a chlárúchán a dhearbhú."
                    }
                },
                "hr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES nije mogao potvrditi da je ovaj broj aktivan za trgovinu unutar EU-a. Provjerite znamenke ili zamolite kupca da potvrdi svoju registraciju."
                    }
                },
                "hu": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "A VIES nem tudta megerősíteni, hogy ez a szám aktív az EU-n belüli kereskedelemben. Ellenőrizze a számjegyeket, vagy kérje meg ügyfelét, hogy erősítse meg a nyilvántartásba vételét."
                    }
                },
                "it": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES non ha potuto confermare che questo numero sia attivo per gli scambi intracomunitari. Controllare le cifre o chiedere al cliente di confermare la propria registrazione."
                    }
                },
                "lt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES nepavyko patvirtinti, kad šis numeris galioja prekybai ES viduje. Patikrinkite skaitmenis arba paprašykite kliento patvirtinti savo registraciją."
                    }
                },
                "lv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES nevarēja apstiprināt, ka šis numurs ir aktīvs ES iekšējai tirdzniecībai. Pārbaudiet ciparus vai lūdziet klientam apstiprināt savu reģistrāciju."
                    }
                },
                "mt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Il-VIES ma setgħetx tikkonferma li dan in-numru huwa attiv għall-kummerċ intra-UE. Iċċekkja ċ-ċifri jew itlob lill-klijent tiegħek jikkonferma r-reġistrazzjoni tiegħu."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES kon niet bevestigen dat dit nummer actief is voor intracommunautaire handel. Controleer de cijfers of vraag uw klant de registratie te bevestigen."
                    }
                },
                "pl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES nie potwierdził, że ten numer jest aktywny w transakcjach wewnątrzwspólnotowych. Sprawdź cyfry lub poproś klienta o potwierdzenie rejestracji."
                    }
                },
                "pt-PT": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "O VIES não conseguiu confirmar que este número está ativo para operações intracomunitárias. Verifique os dígitos ou peça ao seu cliente que confirme o registo."
                    }
                },
                "ro": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES nu a putut confirma că acest număr este activ pentru comerțul intra-UE. Verificați cifrele sau rugați clientul să își confirme înregistrarea."
                    }
                },
                "sk": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES nedokázal potvrdiť, že je toto číslo aktívne na obchodovanie v rámci EÚ. Skontrolujte číslice alebo požiadajte zákazníka o potvrdenie registrácie."
                    }
                },
                "sl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES ni mogel potrditi, da je ta številka aktivna za trgovanje znotraj EU. Preverite števke ali prosite stranko, naj potrdi svojo registracijo."
                    }
                },
                "sv": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "VIES kunde inte bekräfta att numret är aktivt för handel inom EU. Kontrollera siffrorna eller be din kund bekräfta sin registrering."
                    }
                }
            }
        },
